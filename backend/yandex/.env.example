AI_ASSISTANT_ENABLED=false
AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
AI_MODEL_URI=gpt://folder-id/model-id/latest
AI_API_KEY=inject-from-lockbox-at-runtime
YANDEX_FOLDER_ID=folder-id
AI_DAILY_REQUEST_LIMIT=100

# Existing backend variables are required too. Values and credentials must be
# injected at runtime and must never be committed.
FIREBASE_PROJECT_ID=demo-kabinet-25
YANDEX_STORAGE_BUCKET=example-bucket
YANDEX_SERVICE_ACCOUNT_ID=service-account-id
ALLOWED_ORIGINS=http://127.0.0.1:4173
FIREBASE_ADMIN_JSON_B64=inject-from-secret-storage
# A dedicated AI function may instead receive FIREBASE_ADMIN_JSON from a
# Lockbox file payload. The parser accepts either raw JSON or its base64 form.
FIREBASE_ADMIN_JSON=inject-from-lockbox-at-runtime
