rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function isTeacher(teacherId) {
      return hasProfile() && profile().role == "teacher" && request.auth.uid == teacherId;
    }
    function isStudent(studentId) {
      return hasProfile() && profile().role == "student" && profile().studentId == studentId;
    }
    function safeUpload() {
      return request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches(
          '(image/jpeg|image/png|image/webp|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|text/plain)'
        );
    }

    function asset(assetId) {
      return firestore.get(/databases/(default)/documents/fileAssets/$(assetId)).data;
    }

    match /teachers/{teacherId}/homework/{studentId}/{homeworkId}/{assetId}/{fileName} {
      allow read: if isTeacher(teacherId) || isStudent(studentId);
      allow create: if isTeacher(teacherId) && safeUpload();
      allow update: if false;
      allow delete: if isTeacher(teacherId);
    }

    match /students/{studentId}/submissions/{homeworkId}/{assetId}/{fileName} {
      allow read: if isStudent(studentId)
        || (hasProfile() && profile().role == "teacher" && asset(assetId).teacherId == request.auth.uid);
      allow create: if isStudent(studentId) && safeUpload();
      allow update: if false;
      allow delete: if isStudent(studentId)
        || (hasProfile() && profile().role == "teacher" && asset(assetId).teacherId == request.auth.uid);
    }

    match /teachers/{teacherId}/materials/{materialId}/{assetId}/{fileName} {
      allow read: if isTeacher(teacherId)
        || (
          hasProfile()
          && profile().role == "student"
          && profile().studentId in firestore.get(
            /databases/(default)/documents/materials/$(materialId)
          ).data.allowedStudentIds
        );
      allow create: if isTeacher(teacherId) && safeUpload();
      allow update: if false;
      allow delete: if isTeacher(teacherId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
